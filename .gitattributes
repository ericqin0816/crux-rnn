# Preserve the byte hashes frozen during execution across Git checkouts.
configs/final.json -text whitespace=cr-at-eol
configs/final.sha256 -text whitespace=cr-at-eol
src/motor_rnn/*.py -text
configs/final_proposed.json -text whitespace=cr-at-eol
configs/final_proposed.sha256 -text whitespace=cr-at-eol
configs/*.json -text whitespace=cr-at-eol
results/** -text whitespace=cr-at-eol
provenance/environment/** -text whitespace=cr-at-eol
reports/history/** -text whitespace=cr-at-eol
src/cruxrnn/*.py -text
configs/v2/*.json -text whitespace=cr-at-eol
results/v2/** -text whitespace=cr-at-eol
# Matplotlib emits multiline SVG paths with trailing spaces; preserve their hashes.
results/v2/figures/*.svg -text whitespace=-blank-at-eol,cr-at-eol
